# Firebase public config (client-facing) - DO NOT put private server secrets here
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Backend Engine URLs
NEXT_PUBLIC_ENGINE_C_URL=https://engine-c-228557716858.us-central1.run.app
# Ably Real-Time Configuration
# Get your API key from: https://ably.com/dashboard/apps
# For development/testing only - use Secret Manager in production
NEXT_PUBLIC_ABLY_API_KEY=your-ably-api-key-here
