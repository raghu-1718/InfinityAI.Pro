# Main API URL (Engine D - Chatbot) - USE NGINX PROXY
REACT_APP_API_URL=/api/engine-d

# Individual Engine URLs for real-time hooks - USE NGINX PROXY TO AVOID CORS
REACT_APP_ENGINE_A_URL=/api/engine-a
REACT_APP_ENGINE_B_URL=/api/engine-b
REACT_APP_ENGINE_C_URL=/api/engine-c
REACT_APP_ENGINE_D_URL=/api/engine-d
REACT_APP_ENGINE_ULTRA_URL=/api/engine-ultra

# Production settings
REACT_APP_ENV=production
REACT_APP_API_TIMEOUT=10000
