    "firebase-admin": "^12.5.0",
    "firebase-functions": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": "20"
  },
  "private": true
}
