# Engine Analytics (AI & ML) - Development Environment

# Server
PORT=8001
DEBUG=true
LOG_LEVEL=DEBUG

# Gemini API
GEMINI_API_KEY_PRIMARY=your_gemini_api_key_here
GEMINI_API_KEY_SECONDARY=your_gemini_secondary_key_here
GEMINI_MODEL=gemini-1.5-flash

# Firestore (optional, for caching results)
FIRESTORE_PROJECT_ID=after-yesterday-473512-k3
GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account-key.json

# Environment
ENVIRONMENT=development
