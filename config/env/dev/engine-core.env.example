# Engine Core (API Gateway & Orchestrator) - Development Environment

# Server
PORT=8000
DEBUG=true
LOG_LEVEL=DEBUG

# Firestore
FIRESTORE_PROJECT_ID=gen-lang-client-0779271931
GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account-key.json

# Engine URLs (Internal)
ENGINE_ANALYTICS_URL=http://localhost:8001
ENGINE_EXECUTION_URL=http://localhost:8002

# JWT / Auth
JWT_SECRET_KEY=your_development_secret_key_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment
ENVIRONMENT=development
