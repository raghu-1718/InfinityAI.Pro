{
  "displayName": "InfinityAI - High Memory Usage Alert",
  "conditions": [{
    "displayName": "Memory usage above 90%",
    "conditionThreshold": {
      "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=monitoring.regex.full_match(\"infinityai-engine-.*\") AND metric.type=\"run.googleapis.com/container/memory/utilizations\"",
      "aggregations": [{
        "alignmentPeriod": "60s",
        "perSeriesAligner": "ALIGN_MEAN",
        "crossSeriesReducer": "REDUCE_MEAN",
        "groupByFields": ["resource.service_name"]
      }],
      "comparison": "COMPARISON_GT",
      "thresholdValue": 0.9,
      "duration": "300s"
    }
  }],
  "combiner": "OR",
  "enabled": true,
  "notificationChannels": [],
  "alertStrategy": {
    "autoClose": "1800s"
  }
}
