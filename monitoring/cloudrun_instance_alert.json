{
  "displayName": "Cloud Run Instance Spike Alert",
  "conditions": [
    {
      "displayName": "Instance count > 5",
      "conditionThreshold": {
        "filter": "metric.type=\"run.googleapis.com/container/instance_count\" AND resource.type=\"cloud_run_revision\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 5,
        "duration": "300s",
        "aggregations": [
          {
            "alignmentPeriod": "60s",
            "perSeriesAligner": "ALIGN_MAX",
            "crossSeriesReducer": "REDUCE_MAX",
            "groupByFields": ["resource.service_name"]
          }
        ]
      }
    }
  ],
  "notificationChannels": [
    "projects/gen-lang-client-0779271931/notificationChannels/10018032446817284407"
  ],
  "alertStrategy": {
    "autoClose": "86400s"
  }
}
