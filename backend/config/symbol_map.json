  "format_conversion_rules": {
    "internal_to_alpha_vantage": {
      "rule": "symbol + '.NSE'",
      "examples": [
        {
          "internal": "TCS",
          "api": "TCS.NSE"
        },
        {
          "internal": "INFY",
          "api": "INFY.NSE"
        },
        {
          "internal": "HDFCBANK",
          "api": "HDFCBANK.NSE"
        }
      ]
    },
    "internal_to_marketstack": {
      "rule": "symbol as-is (no suffix)",
      "examples": [
        {
          "internal": "TCS",
          "api": "TCS"
        },
        {
          "internal": "INFY",
          "api": "INFY"
        },
        {
          "internal": "HDFCBANK",
          "api": "HDFCBANK"
        }
      ]
    },
    "internal_to_nse_api": {
      "rule": "symbol as-is (no suffix)",
      "examples": [
        {
          "internal": "TCS",
          "api": "TCS"
        },
        {
          "internal": "INFY",
          "api": "INFY"
        }
      ]
    },
    "isin_to_nse_symbol": {
      "rule": "Lookup in symbol_mappings using isin",
      "note": "Some APIs return ISIN; need to convert to NSE symbol"
    }
  },
