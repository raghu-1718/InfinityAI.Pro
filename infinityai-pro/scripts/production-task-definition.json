{
  "family": "infinityai-engine-d",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::152687308610:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::152687308610:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "infinityai-engine-d",
      "image": "152687308610.dkr.ecr.us-east-1.amazonaws.com/infinityai-pro-backend:latest",
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "AWS_DEFAULT_REGION",
          "value": "us-east-1"
        },
        {
          "name": "DHAN_CLIENT_ID",
          "value": "63b3086e"
        },
        {
          "name": "DHAN_CLIENT_SECRET",
          "value": "147fc424-cd90-4bd6-a843-15c3766e2df7"
        },
        {
          "name": "REDIS_HOST",
          "value": "localhost"
        },
        {
          "name": "ENVIRONMENT",
          "value": "production"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/infinityai-engine-d",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}