{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "ecr:*",
                "ecs:*",
                "iam:CreateRole",
                "iam:AttachRolePolicy",
                "iam:PutRolePolicy",
                "iam:GetRole",
                "iam:PassRole",
                "iam:ListRoles",
                "ec2:*",
                "elasticloadbalancing:*",
                "elasticache:*",
                "logs:*",
                "secretsmanager:*",
                "application-autoscaling:*"
            ],
            "Resource": "*"
        }
    ]
}