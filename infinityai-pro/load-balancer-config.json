{
  "load_balancer_configuration": {
    "version": "1.0.0",
    "created": "2025-10-06T17:35:00Z",
    "strategy": "intelligent_routing",
    "enabled": true,
    "engines": {
      "engine_a": {
        "name": "Market Data Ingestion",
        "cloud": "azure",
        "endpoint": "https://infinityai-app--0000036.agreeablemeadow-7375b1f7.eastus.azurecontainerapps.io",
        "health_endpoint": "/health",
        "status": "operational",
        "weight": 25,
        "priority": 1,
        "function": "market_data_ingestion",
        "region": "eastus",
        "capabilities": ["market_data", "websocket", "real_time"]
      },
      "engine_b": {
        "name": "AI Signal Processing",
        "cloud": "gcp",
        "endpoint": "https://infinityai-engine-b-573866363639.us-central1.run.app",
        "health_endpoint": "/health",
        "status": "operational",
        "weight": 25,
        "priority": 1,
        "function": "ai_ml_gpu_processing",
        "region": "us-central1",
        "capabilities": ["ai_processing", "ml_models", "signal_analysis"]
      },
      "engine_c": {
        "name": "Trade Execution",
        "cloud": "aws",
        "endpoint": "http://infinityai-alb-124143296.us-east-1.elb.amazonaws.com/engine-c",
        "health_endpoint": "/health",
        "status": "operational",
        "weight": 25,
        "priority": 1,
        "function": "trade_execution",
        "region": "us-east-1",
        "capabilities": ["trade_execution", "order_management", "portfolio"]
      },
      "engine_d": {
        "name": "AI Chatbot Assistant",
        "cloud": "aws",
        "endpoint": "http://infinityai-alb-124143296.us-east-1.elb.amazonaws.com/engine-d",
        "health_endpoint": "/health",
        "status": "operational",
        "weight": 25,
        "priority": 1,
        "function": "ai_chatbot_assistant",
        "region": "us-east-1",
        "capabilities": ["chatbot", "assistance", "user_interaction"]
      }
    },
    "routing_rules": {
      "market_data": {
        "path_patterns": ["/api/market/*", "/api/data/*", "/ws/market"],
        "target_engine": "engine_a",
        "backup_engines": ["engine_b"]
      },
      "ai_processing": {
        "path_patterns": ["/api/ai/*", "/api/signals/*", "/api/ml/*"],
        "target_engine": "engine_b",
        "backup_engines": ["engine_a"]
      },
      "trading": {
        "path_patterns": ["/api/trade/*", "/api/orders/*", "/api/portfolio/*"],
        "target_engine": "engine_c",
        "backup_engines": ["engine_d"]
      },
      "chatbot": {
        "path_patterns": ["/api/chat/*", "/api/assistant/*", "/api/help/*"],
        "target_engine": "engine_d",
        "backup_engines": ["engine_c"]
      },
      "health_checks": {
        "path_patterns": ["/health", "/status", "/healthz"],
        "strategy": "round_robin",
        "all_engines": true
      }
    },
    "health_monitoring": {
      "interval_seconds": 30,
      "timeout_seconds": 10,
      "retries": 3,
      "healthy_threshold": 2,
      "unhealthy_threshold": 3,
      "circuit_breaker": {
        "enabled": true,
        "failure_threshold": 5,
        "reset_timeout_seconds": 60
      }
    },
    "failover": {
      "enabled": true,
      "automatic": true,
      "timeout_seconds": 5,
      "retry_attempts": 2,
      "fallback_strategy": "round_robin"
    },
    "load_balancing_algorithms": {
      "default": "weighted_round_robin",
      "available": [
        "round_robin",
        "weighted_round_robin",
        "least_connections",
        "ip_hash",
        "geographic"
      ]
    }
  },
  "integration_endpoints": {
    "unified_api_gateway": {
      "enabled": false,
      "note": "Future implementation - single endpoint for all engines"
    },
    "direct_routing": {
      "enabled": true,
      "engines_accessible_individually": true
    }
  },
  "monitoring": {
    "metrics": {
      "response_time": true,
      "success_rate": true,
      "request_count": true,
      "error_rate": true
    },
    "alerting": {
      "enabled": true,
      "thresholds": {
        "response_time_ms": 5000,
        "error_rate_percent": 10,
        "availability_percent": 95
      }
    }
  },
  "security": {
    "cors": {
      "enabled": true,
      "allowed_origins": ["*"],
      "allowed_methods": ["GET", "POST", "PUT", "DELETE"],
      "allowed_headers": ["*"]
    },
    "rate_limiting": {
      "enabled": false,
      "requests_per_minute": 100
    }
  }
}