# InfinityAI.Pro Trading Platform
# Environment Configuration Template

# Environment Type (development, staging, production)
INFINITYAI_ENV=production

# Database Configuration
DATABASE_URL=postgresql://infinityai:CHANGE_ME@postgres:5432/infinityai
TIMESCALE_URL=postgresql://infinityai:CHANGE_ME@timescaledb:5432/market_data

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_SCHEMA_REGISTRY_URL=http://schema-registry:8081

# Dhan Broker Configuration
DHAN_BASE_URL=https://api.dhan.co
DHAN_ACCESS_TOKEN=YOUR_DHAN_ACCESS_TOKEN
DHAN_CLIENT_ID=YOUR_DHAN_CLIENT_ID

# Security Configuration
SECRET_KEY=GENERATE_A_SECURE_SECRET_KEY_HERE
INFINITYAI_VAULT_KEY=GENERATE_A_VAULT_KEY_HERE
INFINITYAI_VAULT_SALT=GENERATE_A_VAULT_SALT_HERE

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring Configuration
METRICS_ENABLED=true
PROMETHEUS_PORT=9090
JAEGER_ENABLED=true

# Performance Configuration
BATCH_PROCESSING_SIZE=100
CONCURRENT_TRADES_LIMIT=10
SIGNAL_PROCESSING_TIMEOUT=5

# Risk Management Configuration
DEFAULT_DAILY_MAX_LOSS=10000.0
DEFAULT_POSITION_LIMIT=100000.0
DEFAULT_MAX_POSITION_SIZE_PERCENT=20.0
DEFAULT_SYMBOL_EXPOSURE_LIMIT=10.0

# Circuit Breaker Configuration
BROKER_CIRCUIT_BREAKER_THRESHOLD=5
BROKER_CIRCUIT_BREAKER_TIMEOUT=60
RISK_CIRCUIT_BREAKER_THRESHOLD=3
RISK_CIRCUIT_BREAKER_TIMEOUT=30

# GPU Configuration (Engine B)
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# Paper Trading (set to true for testing)
PAPER_TRADE=false