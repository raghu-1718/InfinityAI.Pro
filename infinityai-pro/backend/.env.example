# Cloud Services Configuration
# Environment variables for multi-cloud AI and storage services

# ==========================================
# PINECONE VECTOR DATABASE (Free Tier)
# ==========================================
# Get API key from: https://www.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=gcp-starter
PINECONE_INDEX_NAME=infinityai-vectors
VECTOR_DIMENSION=384

# ==========================================
# AZURE AI SERVICES (Free Credits Available)
# ==========================================
# Azure OpenAI
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string_here
AZURE_CONTAINER_NAME=infinityai-models

# Azure Speech Services
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# ==========================================
# AWS SERVICES (Free Tier)
# ==========================================
# AWS Credentials (from AWS Console -> IAM)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# S3 Bucket for storage
AWS_S3_BUCKET=infinityai-storage

# ==========================================
# GOOGLE CLOUD PLATFORM (Free Credits)
# ==========================================
# Google Cloud Project
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here
GOOGLE_CLOUD_LOCATION=us-central1

# Service Account Key (JSON file path or content)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ==========================================
# PRIMARY SERVICE SELECTION
# ==========================================
# Choose which service to use as primary (others as failover)
PRIMARY_AI_SERVICE=azure_openai
PRIMARY_VECTOR_DB=pinecone
PRIMARY_STORAGE=azure

# ==========================================
# RUNPOD ENDPOINTS (Optional - for GPU tasks)
# ==========================================
RUNPOD_SD_ENDPOINT=https://api.runpod.ai/v2/your-sd-endpoint/runsync
RUNPOD_YOLO_ENDPOINT=https://api.runpod.ai/v2/your-yolo-endpoint/runsync
RUNPOD_WHISPER_ENDPOINT=https://api.runpod.ai/v2/your-whisper-endpoint/runsync
RUNPOD_API_KEY=your_runpod_api_key_here

# ==========================================
# FINANCIAL DATA APIS (Free Tiers)
# ==========================================
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
FINANCIAL_DATA_PROVIDER=alpha_vantage  # Options: alpha_vantage, yahoo_finance, polygon

# ==========================================
# LOGGING AND MONITORING
# ==========================================
LOG_LEVEL=INFO
ENABLE_CLOUD_LOGGING=false

# ==========================================
# SETUP INSTRUCTIONS
# ==========================================
# 1. Pinecone: Sign up at pinecone.io, create index with 384 dimensions
# 2. Azure: Create resource in Azure Portal, get OpenAI and Storage keys
# 3. AWS: Create IAM user, S3 bucket, get access keys
# 4. Google: Create GCP project, enable Vertex AI, create service account
# 5. Copy this file to .env and fill in your credentials
# 6. The app will automatically use free tiers and failover between services