# Engine B - AI Signal Processing Service
# InfinityAI.Pro Trading Platform
# Multi-stage Docker build with GPU support

# Build stage with CUDA support
FROM nvidia/cuda:11.8-devel-ubuntu20.04 as builder

# Set build arguments
ARG BUILD_DATE
ARG GIT_COMMIT
ARG VERSION=1.0.0

# Avoid interactive prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3.11-dev \
    python3.11-distutils \
    python3-pip \
    build-essential \
    cmake \
    pkg-config \
    libhdf5-dev \
    libopenblas-dev \
    liblapack-dev \
    gfortran \
    libjpeg-dev \
    libpng-dev \
    libtiff-dev \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    libv4l-dev \
    libxvidcore-dev \
    libx264-dev \
    libgtk-3-dev \
    libatlas-base-dev \
    curl \
    wget \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
WORKDIR /app
COPY requirements.txt .

# Install PyTorch with CUDA support first
RUN pip3 install --no-cache-dir torch==2.1.1+cu118 torchvision==0.16.1+cu118 torchaudio==0.14.1+cu118 --index-url https://download.pytorch.org/whl/cu118

# Install other requirements
RUN pip3 install --no-cache-dir -r requirements.txt

# Production stage
FROM nvidia/cuda:11.8-runtime-ubuntu20.04 as production

# Set build arguments
ARG BUILD_DATE
ARG GIT_COMMIT
ARG VERSION=1.0.0

# Add labels for metadata
LABEL maintainer="InfinityAI.Pro Team" \
      version="${VERSION}" \
      description="Engine B - AI Signal Processing Service" \
      build-date="${BUILD_DATE}" \
      git-commit="${GIT_COMMIT}" \
      component="ai-signal-processing"

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3.11-distutils \
    libhdf5-103 \
    libopenblas0 \
    liblapack3 \
    libgomp1 \
    libjpeg8 \
    libpng16-16 \
    libtiff5 \
    libavcodec58 \
    libavformat58 \
    libswscale5 \
    libv4l-0 \
    libxvidcore4 \
    libx264-155 \
    libgtk-3-0 \
    libatlas3-base \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user for security
RUN groupadd -r infinityai && useradd -r -g infinityai -s /bin/bash infinityai

# Set working directory
WORKDIR /app

# Copy Python dependencies from builder stage
COPY --from=builder /usr/local/lib/python3.11 /usr/local/lib/python3.11
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY . .

# Create necessary directories for models and data
RUN mkdir -p /app/logs /app/data /app/tmp /app/models && \
    chown -R infinityai:infinityai /app

# Switch to non-root user
USER infinityai

# Set environment variables
ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    INFINITYAI_ENV=production \
    LOG_LEVEL=INFO \
    API_HOST=0.0.0.0 \
    API_PORT=8000 \
    CUDA_VISIBLE_DEVICES=0

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${API_PORT}/health || exit 1

# Expose port
EXPOSE 8000

# Default command
CMD ["python3.11", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]

# Development stage (optional)
FROM production as development

# Switch back to root for development packages
USER root

# Install development dependencies
RUN apt-get update && apt-get install -y \
    vim \
    git \
    htop \
    nvidia-smi \
    && rm -rf /var/lib/apt/lists/*

# Install additional Python development tools
RUN pip3 install --no-cache-dir \
    jupyter \
    ipython \
    matplotlib \
    seaborn \
    plotly \
    tensorboard

# Switch back to non-root user
USER infinityai

# Override CMD for development
CMD ["python3.11", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--log-level", "debug"]