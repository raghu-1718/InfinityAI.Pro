# =============================================================================
# InfinityAI.Pro Engine B - Enhanced GPU-Optimized AI Processing Engine
# Latest CUDA 12.2 with advanced AI/ML GPU acceleration
# =============================================================================

# Multi-stage build with latest CUDA support
FROM nvidia/cuda:12.2-devel-ubuntu22.04 as builder

# Set GPU environment variables
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies for AI/ML
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3.11-dev \
    python3-pip \
    build-essential \
    cmake \
    git \
    wget \
    curl \
    libssl-dev \
    libffi-dev \
    libbz2-dev \
    libreadline-dev \
    libsqlite3-dev \
    llvm \
    libncurses5-dev \
    libncursesw5-dev \
    xz-utils \
    tk-dev \
    libxml2-dev \
    libxmlsec1-dev \
    liblzma-dev \
    libopenblas-dev \
    liblapack-dev \
    gfortran \
    libhdf5-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Create python symlink
RUN ln -s /usr/bin/python3.11 /usr/bin/python

# Upgrade pip and install wheel
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel

# Install PyTorch with CUDA 12.1 support (latest stable)
RUN pip3 install --no-cache-dir \
    torch==2.1.0+cu121 \
    torchvision==0.16.0+cu121 \
    torchaudio==2.1.0+cu121 \
    --index-url https://download.pytorch.org/whl/cu121

# Install XGBoost with GPU support
RUN pip3 install --no-cache-dir xgboost[gpu]==2.0.2

# Install LightGBM with GPU support (compile from source for best performance)
RUN pip3 install --no-cache-dir lightgbm --config-settings=cmake.define.USE_CUDA=ON

# Install CuPy for GPU-accelerated NumPy operations
RUN pip3 install --no-cache-dir cupy-cuda12x==12.3.0

# Install RAPIDS for GPU-accelerated data science
RUN pip3 install --no-cache-dir \
    cuml-cu12==23.12.0 \
    cudf-cu12==23.12.0 \
    cusignal-cu12==23.12.0 \
    cugraph-cu12==23.12.0

# Install TensorFlow with GPU support
RUN pip3 install --no-cache-dir tensorflow[and-cuda]==2.15.0

# Install PyTorch Lightning for distributed training
RUN pip3 install --no-cache-dir pytorch-lightning==2.1.2

# Install additional AI/ML libraries
RUN pip3 install --no-cache-dir \
    numba==0.58.1 \
    scikit-learn==1.3.2 \
    optuna==3.4.0 \
    hyperopt==0.2.7 \
    catboost==1.2.2

# Install GPU monitoring and utilities
RUN pip3 install --no-cache-dir \
    nvidia-ml-py==12.535.108 \
    pycuda==2023.1 \
    scikit-cuda==0.5.3 \
    gpustat==1.1.1 \
    pynvml==11.5.0

# Production stage
FROM nvidia/cuda:12.2-runtime-ubuntu22.04 as production

# Set build metadata
ARG BUILD_DATE
ARG GIT_COMMIT
ARG VERSION=2.0.0

LABEL maintainer="InfinityAI.Pro Team" \
      version="${VERSION}" \
      description="Engine B - Enhanced GPU AI Processing Service" \
      build-date="${BUILD_DATE}" \
      git-commit="${GIT_COMMIT}" \
      component="gpu-ai-processing"

# Copy CUDA from builder
COPY --from=builder /usr/local/cuda /usr/local/cuda

# Set GPU environment
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}
ENV DEBIAN_FRONTEND=noninteractive

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3-pip \
    curl \
    libgomp1 \
    libopenblas0 \
    liblapack3 \
    libhdf5-103-1 \
    && rm -rf /var/lib/apt/lists/*

# Create python symlink
RUN ln -s /usr/bin/python3.11 /usr/bin/python

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.11/dist-packages /usr/local/lib/python3.11/dist-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Create non-root user
RUN groupadd -r infinityai && useradd -r -g infinityai -s /bin/bash infinityai

# Set working directory
WORKDIR /app

# Create necessary directories
RUN mkdir -p /app/logs /app/data /app/tmp /app/models/cache /app/models/checkpoints

# Copy requirements and install additional dependencies
COPY requirements-gpu.txt ./
RUN pip3 install --no-cache-dir -r requirements-gpu.txt

# Copy application code
COPY . .

# Set permissions
RUN chown -R infinityai:infinityai /app

# Switch to non-root user
USER infinityai

# Health check with comprehensive GPU verification
HEALTHCHECK --interval=30s --timeout=20s --start-period=180s --retries=3 \
    CMD python -c "import torch, cupy, xgboost as xgb; \
        assert torch.cuda.is_available(), 'PyTorch CUDA not available'; \
        assert cupy.cuda.is_available(), 'CuPy CUDA not available'; \
        print(f'GPU: {torch.cuda.get_device_name(0)}'); \
        print(f'CUDA Memory: {torch.cuda.get_device_properties(0).total_memory / 1e9:.2f} GB'); \
        print(f'PyTorch Version: {torch.__version__}'); \
        print('Enhanced AI Engine B GPU check passed')" && \
        curl -f http://localhost:8002/health || exit 1

# Expose port
EXPOSE 8002

# GPU optimization environment variables
ENV CUDA_CACHE_DISABLE=0
ENV CUDA_CACHE_MAXSIZE=4294967296
ENV PYTHONUNBUFFERED=1
ENV OMP_NUM_THREADS=4
ENV MKL_NUM_THREADS=4

# PyTorch optimizations for trading
ENV PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:1024,roundup_power2_divisions:16,expandable_segments:True
ENV TORCH_CUDNN_V8_API_ENABLED=1
ENV TORCH_CUDNN_BENCHMARK=1

# XGBoost GPU settings
ENV CUDA_LAUNCH_BLOCKING=0
ENV XGBOOST_GPU_DEVICE=0

# TensorFlow GPU settings
ENV TF_GPU_ALLOCATOR=cuda_malloc_async
ENV TF_GPU_THREAD_MODE=gpu_private
ENV TF_FORCE_GPU_ALLOW_GROWTH=true

# AI model optimization
ENV TRANSFORMERS_CACHE=/app/models/cache
ENV HF_HOME=/app/models/cache
ENV TORCH_HOME=/app/models/cache

# InfinityAI specific settings
ENV INFINITYAI_ENV=production
ENV LOG_LEVEL=INFO
ENV API_HOST=0.0.0.0
ENV API_PORT=8002

# Memory and performance settings
ENV MALLOC_TRIM_THRESHOLD_=100000
ENV MALLOC_MMAP_THRESHOLD_=100000

# Start the enhanced GPU-accelerated AI engine
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8002", "--workers", "1", "--loop", "uvloop"]

# Development stage
FROM production as development

# Switch to root for dev packages
USER root

# Install development tools
RUN apt-get update && apt-get install -y \
    vim \
    git \
    htop \
    nvtop \
    tree \
    && rm -rf /var/lib/apt/lists/*

# Install development Python packages
RUN pip3 install --no-cache-dir \
    jupyter \
    jupyterlab \
    ipython \
    matplotlib \
    seaborn \
    plotly \
    tensorboard \
    wandb \
    mlflow

# Install GPU profiling tools
RUN pip3 install --no-cache-dir \
    py-spy \
    memory-profiler \
    line-profiler

# Switch back to infinityai user
USER infinityai

# Override CMD for development
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8002", "--reload", "--log-level", "debug"]