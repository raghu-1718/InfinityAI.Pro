# InfinityAI.Pro - Complete Production Environment Configuration
# Updated: 2025-09-30

# ==========================================
# INFRASTRUCTURE SETTINGS
# ==========================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
PORT=8000
ENABLE_CLOUD_LOGGING=true

# ==========================================
# AWS SERVICES (Configured & Working)
# ==========================================
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=infinityai-storage
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
AWS_BEARER_TOKEN_BEDROCK=your_aws_bearer_token_here

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Amazon Keyspaces (Cassandra)
CASSANDRA_USERNAME=your_cassandra_username_here
CASSANDRA_PASSWORD=your_cassandra_password_here
CASSANDRA_HOSTS=cassandra.us-east-1.amazonaws.com:9142
CASSANDRA_KEYSPACE=infinityai_keyspace

# Redis (for caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_TTL=3600

# Connection Pooling
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ==========================================
# AI SERVICE API KEYS (MISSING - NEED TO ADD)
# ==========================================
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Perplexity AI
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Hugging Face
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL_CACHE=/tmp/huggingface

# ==========================================
# AZURE AI SERVICES (NEED ACTUAL KEYS)
# ==========================================
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus
AZURE_VISION_KEY=your_azure_vision_key_here
AZURE_VISION_REGION=eastus
AZURE_TEXT_ANALYTICS_KEY=your_azure_text_analytics_key_here
AZURE_TEXT_ANALYTICS_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string_here
AZURE_CONTAINER_NAME=infinityai-models

# Azure Key Vault
AZURE_KEY_VAULT_URL=https://infinityai-vault.vault.azure.net/
AZURE_TENANT_ID=your_azure_tenant_id_here
AZURE_CLIENT_ID=your_azure_client_id_here
AZURE_CLIENT_SECRET=your_azure_client_secret_here

# ==========================================
# VECTOR DATABASE
# ==========================================
# Pinecone (MISSING KEY)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=gcp-starter
PINECONE_INDEX_NAME=infinityai-vectors
VECTOR_DIMENSION=384

# ChromaDB (Local/Render)
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION_NAME=infinityai_embeddings

# ==========================================
# FINANCIAL DATA APIS (MISSING KEYS)
# ==========================================
# Alpha Vantage (Primary)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co

# Yahoo Finance (Fallback)
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com

# Polygon.io (Alternative)
POLYGON_API_KEY=your_polygon_api_key_here
POLYGON_BASE_URL=https://api.polygon.io

# Twelve Data (Alternative)
TWELVE_DATA_API_KEY=your_twelve_data_key_here
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# ==========================================
# TRADING BROKER CREDENTIALS
# ==========================================
# Dhan Trading (Working)
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_CLIENT_SECRET=your_dhan_client_secret_here
DHAN_ACCESS_TOKEN=your_dhan_access_token_here
DHAN_BASE_URL=https://api.dhan.co
BROKER_TYPE=dhan

# CoinSwitch (MISSING KEYS)
COINSWITCH_API_KEY=your_coinswitch_api_key_here
COINSWITCH_API_SECRET=your_coinswitch_api_secret_here
COINSWITCH_BASE_URL=https://api-trading.coinswitch.co

# Zerodha Kite (Alternative)
ZERODHA_API_KEY=your_zerodha_api_key_here
ZERODHA_API_SECRET=your_zerodha_api_secret_here
ZERODHA_ACCESS_TOKEN=your_zerodha_access_token_here

# ==========================================
# SERVICE CONFIGURATION
# ==========================================
PRIMARY_AI_SERVICE=azure_openai
FALLBACK_AI_SERVICE=openai
PRIMARY_VECTOR_DB=pinecone
FALLBACK_VECTOR_DB=chroma
PRIMARY_STORAGE=aws
FALLBACK_STORAGE=azure
STORAGE_PROVIDER=aws

# ==========================================
# EXTERNAL INTEGRATIONS
# ==========================================
# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Discord Webhook
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Slack Integration
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_CHANNEL=your_slack_channel_here

# ==========================================
# RENDER SERVICES
# ==========================================
OLLAMA_URL=https://ollama.infinityai.pro
CHROMA_URL=https://chroma.infinityai.pro

# ==========================================
# MONITORING & LOGGING
# ==========================================
# Sentry
SENTRY_DSN=your_sentry_dsn_here

# DataDog
DATADOG_API_KEY=your_datadog_api_key_here

# LogRocket
LOGROCKET_APP_ID=your_logrocket_app_id_here

# ==========================================
# PERFORMANCE OPTIMIZATION
# ==========================================
# Cache Settings
CACHE_TTL=300
CACHE_MAX_SIZE=1000
ENABLE_RESPONSE_CACHING=true
ENABLE_QUERY_CACHING=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_BURST=20

# ==========================================
# SECURITY SETTINGS
# ==========================================
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRY_HOURS=24
CORS_ORIGINS=https://infinityai.pro,https://www.infinityai.pro
API_KEY_ENCRYPTION_KEY=your_api_key_encryption_key_here

# ==========================================
# FEATURE FLAGS
# ==========================================
ENABLE_AI_TRADING=true
ENABLE_PAPER_TRADING=false
ENABLE_LIVE_TRADING=true
ENABLE_CRYPTO_TRADING=true
ENABLE_OPTIONS_TRADING=true
ENABLE_FUTURES_TRADING=true