{
  "family": "infinityai-engine-d",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::ACCOUNT-ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT-ID:role/infinityai-engine-d-task-role",
  "containerDefinitions": [
    {
      "name": "engine-d-container",
      "image": "ACCOUNT-ID.dkr.ecr.us-east-1.amazonaws.com/infinityai-engine-d:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "ENVIRONMENT",
          "value": "production"
        },
        {
          "name": "AWS_DEFAULT_REGION",
          "value": "us-east-1"
        },
        {
          "name": "REDIS_HOST",
          "value": "infinityai-redis-cluster.cache.amazonaws.com"
        }
      ],
      "secrets": [
        {
          "name": "DHAN_CLIENT_ID",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT-ID:secret:infinityai/dhan-credentials:client_id::"
        },
        {
          "name": "DHAN_CLIENT_SECRET", 
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT-ID:secret:infinityai/dhan-credentials:client_secret::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/infinityai-engine-d",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8000/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}