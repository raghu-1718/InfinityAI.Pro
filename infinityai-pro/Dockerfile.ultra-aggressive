# 🚀 Google Cloud Run Deployment for InfinityAI.Pro Ultra Aggressive Trading
# This Dockerfile creates a production-ready container for Google Cloud Run

FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PORT=8080
ENV ENVIRONMENT=production
ENV ULTRA_AGGRESSIVE_MODE=true

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install additional dependencies for ultra-aggressive trading
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn[standard] \
    python-multipart \
    websockets \
    redis \
    celery \
    pandas \
    numpy \
    aiohttp \
    python-dotenv

# Copy application code
COPY . .

# Copy ultra-aggressive trading system
COPY ultra_aggressive_main.py .
COPY real_ultra_aggressive_trader.py .

# Create logs directory
RUN mkdir -p /app/logs

# Set permissions
RUN chmod +x ultra_aggressive_main.py

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# Expose port
EXPOSE ${PORT}

# Start ultra-aggressive trading system with dynamic funds
CMD ["python", "-m", "uvicorn", "ultra_aggressive_integrated:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "4"]