{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install",
  "framework": "create-react-app",
  "env": {
    "REACT_APP_API_URL": "https://api.infinityai.pro",
    "REACT_APP_WS_URL": "wss://api.infinityai.pro",
    "REACT_APP_VERSION": "1.0.0",
    "REACT_APP_ENVIRONMENT": "production",
    "REACT_APP_AZURE_ENGINE_A_URL": "https://api.azure.infinityai.pro/engine-a",
    "REACT_APP_GCP_ENGINE_B_URL": "https://api.gcp.infinityai.pro/engine-b",
    "REACT_APP_AWS_ENGINE_C_URL": "https://api.aws.infinityai.pro/engine-c",
    "REACT_APP_VERCEL_ENGINE_D_URL": "https://api.vercel.infinityai.pro/engine-d"
  },
  "build": {
    "env": {
      "REACT_APP_API_URL": "https://api.infinityai.pro",
      "REACT_APP_WS_URL": "wss://api.infinityai.pro",
      "REACT_APP_VERSION": "1.0.0",
      "REACT_APP_ENVIRONMENT": "production"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/engine-a/:path*",
      "destination": "https://api.azure.infinityai.pro/engine-a/:path*"
    },
    {
      "source": "/api/engine-b/:path*",
      "destination": "https://api.gcp.infinityai.pro/engine-b/:path*"
    },
    {
      "source": "/api/engine-c/:path*",
      "destination": "https://api.aws.infinityai.pro/engine-c/:path*"
    },
    {
      "source": "/api/engine-d/:path*",
      "destination": "https://api.vercel.infinityai.pro/engine-d/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
