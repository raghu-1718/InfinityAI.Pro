
{
  "family": "infinityai-engine-c",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::152687308610:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "infinityai-engine-c",
      "image": "python:3.9-slim",
      "command": [
        "sh", "-c",
        "pip install fastapi uvicorn requests pydantic && python -c \"from fastapi import FastAPI; import uvicorn; app = FastAPI(); @app.get('/health'); def health(): return {'status': 'healthy', 'engine': 'trade_execution', 'version': '2.0.0'}; @app.get('/engine-c/health'); def engine_health(): return {'status': 'healthy', 'engine': 'trade_execution', 'version': '2.0.0'}; uvicorn.run(app, host='0.0.0.0', port=8000)\""
      ],
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "ENGINE_TYPE", "value": "trade_execution" },
        { "name": "PORT", "value": "8000" },
        { "name": "DHAN_API_ENABLED", "value": "true" },
        { "name": "DHAN_CLIENT_ID", "value": "1101302170" },
        { "name": "DHAN_ACCESS_TOKEN", "value": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzUxMiJ9..SdnAubAOeObBTLmEYWTUP9lBW2MapBPeQL2b57mV8or-8tqUZwiIVmZywIzbkhRPViGKrqOH56ClQUXJL9oawA" },
        { "name": "DHAN_SANDBOX_MODE", "value": "false" },
        { "name": "DHAN_ENVIRONMENT", "value": "production" },
        { "name": "DHAN_API_BASE_URL", "value": "https://api.dhan.co/v2" },
        { "name": "DHAN_API_KEY", "value": "a1196f5b" },
        { "name": "DHAN_API_SECRET", "value": "66e16669-1b5e-4db7-9aec-4da4f56a2530" },
        { "name": "API_KEY", "value": "INFINITY_API_20251006_7145" },
        { "name": "API_SECRET", "value": "INFINITY_SECRET_202510060712_98432" },
        { "name": "DATA_API_KEY", "value": "INFINITY_DATA_20251006_8934" },
        { "name": "DATA_API_SECRET", "value": "INFINITY_DATA_SECRET_20251006_45672" },
        { "name": "ENGINE_A_URL", "value": "https://infinityai-app.agreeablemeadow-7375b1f7.eastus.azurecontainerapps.io" },
        { "name": "WEBHOOK_URL", "value": "https://infinityai-app.agreeablemeadow-7375b1f7.eastus.azurecontainerapps.io/api/webhooks/dhan" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/infinityai-engine-c",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}