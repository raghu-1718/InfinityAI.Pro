# Multi-Cloud Ultra Aggressive Trading Dockerfile
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PORT=8080
ENV ULTRA_AGGRESSIVE_MODE=true
ENV MULTI_CLOUD_INTEGRATION=true

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install additional dependencies
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn[standard] \
    python-multipart \
    websockets \
    redis \
    aiohttp \
    python-dotenv

# Copy application code
COPY . .
COPY multi_cloud_ultra_aggressive.py .

# Create logs directory
RUN mkdir -p /app/logs

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# Expose port
EXPOSE ${PORT}

# Start multi-cloud ultra aggressive trading
CMD ["python", "-m", "uvicorn", "multi_cloud_ultra_aggressive:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "2"]