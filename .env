# InfinityAI.Pro Environment Configuration

# ===========================================
# DHAN API CONFIGURATION
# ===========================================
# Get your credentials from: https://dhanhq.co/api
# Documentation: https://dhanhq.co/docs/

# Dhan API Credentials (DO NOT COMMIT REAL VALUES)
# Replace the placeholders locally or inject via Secret Manager
DHAN_ACCESS_TOKEN=__REDACTED__
DHAN_CLIENT_ID=__REDACTED__
DHAN_API_KEY=__REDACTED__
DHAN_API_SECRET=__REDACTED__

# Dhan API Callback URLs (UPDATE THESE AFTER DEPLOYMENT)
# Postback URL: https://infinityai.pro/api/webhooks/dhan
# Redirect URL: https://infinityai.pro/auth/dhan/callback

# ===========================================
# ENGINE URLs (GCP Cloud Run Production)
# Source of truth: reports/PRODUCTION_AUDIT_REPORT_2025-10-20.md
# ===========================================
ENGINE_A_URL=https://infinityai-engine-a-ckxt6xvshq-uc.a.run.app
ENGINE_B_URL=https://infinityai-engine-b-ckxt6xvshq-uc.a.run.app
ENGINE_C_URL=https://api.infinityai.pro
ENGINE_D_URL=https://engine.infinityai.pro

# ===========================================
# CLOUD CONFIGURATION (GCP Only)
# ===========================================

# GCP Configuration
# Project from audit report
GCP_PROJECT_ID=infinity-ai-5ec7c
GCP_REGION=us-central1

# Custom Domain
CUSTOM_DOMAIN=infinityai.pro

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# Generate strong secrets for production
API_SECRET_KEY=__SET_VIA_SECRET_MANAGER__
JWT_SECRET=__SET_VIA_SECRET_MANAGER__

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
# Environment
NODE_ENV=production
ENVIRONMENT=production

# Logging
LOG_LEVEL=INFO

# Database (Optional - using in-memory for now)
DATABASE_URL=sqlite:///./infinityai.db

# ===========================================
# DEPLOYMENT CONFIGURATION
# ===========================================
# Domain Configuration
FRONTEND_URL=https://infinityai.pro
API_BASE_URL=https://infinityai.pro/api

# CORS Configuration
ALLOWED_ORIGINS=https://infinityai.pro,http://localhost:3000

# ===========================================
# TRADING CONFIGURATION
# ===========================================
# Risk Management
MAX_POSITION_SIZE=100000
MAX_DAILY_LOSS=50000
MAX_OPEN_POSITIONS=10

# Trading Hours (IST)
TRADING_START_TIME=09:15
TRADING_END_TIME=15:30

# ===========================================
# MONITORING CONFIGURATION
# ===========================================
# Health Check Intervals
HEALTH_CHECK_INTERVAL=30
ALERT_THRESHOLD_MS=5000

# ===========================================
# WEBHOOK CONFIGURATION
# ===========================================
# Dhan Webhook Configuration
DHAN_WEBHOOK_URL=https://infinityai.pro/api/webhooks/dhan
DHAN_WEBHOOK_SECRET=your_webhook_secret_here

# ===========================================
# NOTES FOR SETUP:
# ===========================================
# 1. Replace all "your_*_here" values with actual credentials
# 2. Get Dhan API access from: https://dhanhq.co/api
# 3. Use these URLs in Dhan API configuration:
#    - Postback URL: https://infinityai.pro/api/webhooks/dhan
#    - Redirect URL: https://infinityai.pro/auth/dhan/callback
# 4. Generate strong secrets for API_SECRET_KEY and JWT_SECRET
# 5. Update ENGINE_*_URL values after deployment