{
    "family": "infinityai-engine-c",
    "executionRoleArn": "arn:aws:iam::152687308610:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "name": "infinityai-engine-c",
            "image": "152687308610.dkr.ecr.us-east-1.amazonaws.com/infinityai-engine-c:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 8002,
                    "hostPort": 8002,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "ENGINE_B_URL",
                    "value": "https://infinityai-engine-b-573866363639.us-central1.run.app"
                },
                {
                    "name": "PORT",
                    "value": "8002"
                },
                {
                    "name": "ENGINE_A_URL",
                    "value": "https://infinityai-engine-a-573866363639.us-central1.run.app"
                },
                {
                    "name": "ENGINE_D_URL",
                    "value": "http://infinityai-alb-124143296.us-east-1.elb.amazonaws.com/engine-d"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "curl -f http://localhost:8002/health || exit 1"
                ],
                "interval": 30,
                "timeout": 5,
                "retries": 3
            }
        }
    ],
    "volumes": [],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "512",
    "memory": "1024"
}