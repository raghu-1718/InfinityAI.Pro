## gemini.env - runtime reference for local dev
## This file references the secret name rather than the secret value.
GEMINI_API_PROVIDER="google-ai"
MODEL="gemini-1.5-pro"
COLLECTION_PATH="/ai_tasks"
# If you run locally you may point this to a local env variable that holds the key,
# but do NOT commit real keys. Example: export GEMINI_API_KEY_PRIMARY=...
GEMINI_API_KEY_SECRET_NAME="GEMINI_API_KEY_PRIMARY"
RESPONSE_FIELD="result"
