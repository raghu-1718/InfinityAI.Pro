## GEMINI configuration - TEMPLATE
## NOTE: API keys MUST NOT be stored in the repository. Replace these values
## by storing secrets in Google Secret Manager (GSM) or GitHub Secrets and
## referencing them at runtime. This file is a template only.

GEMINI_API_PROVIDER=google-ai
MODEL=gemini-1.5-flash
COLLECTION_PATH=/ai_tasks
# Replace these with calls to your secret manager at runtime. Do NOT commit
# real keys here. Example secret names: GEMINI_API_KEY_PRIMARY, GEMINI_API_KEY_SECONDARY
GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_SECONDARY=
RESPONSE_FIELD=result
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.7
