{
  "servers": {
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": {
        "MEMORY_FILE_PATH": "${workspaceFolder}/.memory/memory.jsonl"
      }
    },
    "git": {
      "command": "python",
      "args": ["-m", "mcp_server_git", "--repository", "${workspaceFolder}"]
    }
  }
}
