rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users: Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Trades: Users can read/create their own trades
    match /trades/{tradeId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if false; // Trades should be immutable from client or handled by backend
    }

    // Signals: Users can read their own signals
    match /signals/{signalId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Signals are generated by backend
    }

    // Trade Audit: Read for Owner (Optimized for queries)
    match /trade_audit/{docId} {
      allow read: if request.auth != null && 
                  (resource == null || resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Trading Sessions: Read-Only for Owner
    match /trading_sessions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Nested state documents
      match /state/{stateId} {
        allow read: if request.auth != null && request.auth.uid == userId;
      }
      
      // Catch-all for subcollections
      match /{allSubcollections=**} {
        allow read: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}