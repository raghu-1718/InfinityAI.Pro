rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read/write their own profile data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow creation for new users during signup
      allow create: if request.auth != null;
    }

    // Coupon system - backend managed (Cloud Run services)
    match /coupons/{couponId} {
      allow read: if true;  // Allow verification
      allow write: if false; // Only backend can write
    }

    // Coupon sessions - backend managed
    match /coupon_sessions/{sessionId} {
      allow read: if true;  // Allow session lookup
      allow write: if false; // Only backend can write
    }

    // Dhan credentials: write-only for users, read for cloud functions
    match /dhan_credentials/{userId} {
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow read: if false; // No client read access
    }

    // Demat, portfolio, and funds — user-restricted
    match /demat_accounts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Trading sessions and logs — user-restricted
    match /trading_sessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      match /logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == resource.parent.data.userId;
      }
    }

    // Engine health, AI signals, trades — public read, BACKEND WRITE ONLY (Phase-5 Fix)
    match /engine_health/{docId} {
      allow read: if true;
      allow write: if false;  // Backend service accounts only
    }

    match /ai_signals/{docId} {
      allow read: if true;
      allow write: if false;  // Backend service accounts only (Phase-5 Security Fix)
    }

    match /trades/{docId} {
      allow read: if true;
      allow write: if false;  // Backend service accounts only (Phase-5 Security Fix)
    }

    // Activity logs — backend write only
    match /activity_logs/{docId} {
      allow read: if request.auth != null;
      allow write: if false;  // Backend service accounts only
    }
  }
}