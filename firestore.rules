rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read/write their own profile data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Dhan credentials: write-only for users, read for cloud functions
    match /dhan_credentials/{userId} {
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow read: if false; // No client read access
    }

    // Demat, portfolio, and funds — user-restricted
    match /demat_accounts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Trading sessions and logs — user-restricted
    match /trading_sessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      match /logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == resource.parent.data.userId;
      }
    }

    // Engine health, AI signals, trades — public read, function write
    match /engine_health/{docId} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }

    match /ai_signals/{docId} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }

    match /trades/{docId} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }
  }
}