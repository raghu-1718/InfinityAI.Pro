{
  "models": {
    "gemini": {
      "provider": "google",
      "model": "gemini-2.0-pro",
      "apiKey": "${env:GEMINI_API_KEY}"
    },
    "openai": {
      "provider": "openai",
      "model": "gpt-5",
      "apiKey": "${env:OPENAI_API_KEY}"
    },
    "anthropic": {
      "provider": "anthropic",
      "model": "claude-3.5-sonnet",
      "apiKey": "${env:ANTHROPIC_API_KEY}"
    }
  },
  "mcp": {
    "enabled": true,
    "contextLimit": 8192,
    "tools": ["firestore", "gcp", "http", "shell"]
  }
}
