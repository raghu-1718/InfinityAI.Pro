{
  "version": 2,
  "builds": [
    {
      "src": "api-webhooks/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    {
      "src": "/api-webhooks/(.*)",
      "dest": "api-webhooks/main.py"
    }
  ]
}
