{
  "security_group_rules": [
    {
      "description": "Allow HTTP traffic on port 8000 for Engine D",
      "type": "ingress",
      "from_port": 8000,
      "to_port": 8000,
      "protocol": "tcp",
      "cidr_blocks": ["0.0.0.0/0"]
    },
    {
      "description": "Allow HTTP traffic on port 8002 for Engine C",
      "type": "ingress", 
      "from_port": 8002,
      "to_port": 8002,
      "protocol": "tcp",
      "cidr_blocks": ["0.0.0.0/0"]
    },
    {
      "description": "Allow HTTPS traffic on port 443",
      "type": "ingress",
      "from_port": 443,
      "to_port": 443,
      "protocol": "tcp",
      "cidr_blocks": ["0.0.0.0/0"]
    },
    {
      "description": "Allow HTTP traffic on port 80",
      "type": "ingress",
      "from_port": 80,
      "to_port": 80,
      "protocol": "tcp",
      "cidr_blocks": ["0.0.0.0/0"]
    }
  ]
}