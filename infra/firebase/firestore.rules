rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read/write their own profile data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow creation for new users during signup
      allow create: if request.auth != null;
    }

    // Coupon system - backend managed (Cloud Run services)
    match /coupons/{couponId} {
      allow read: if true;  // Allow verification
      allow write: if false; // Only backend can write
    }

    // Coupon sessions - backend managed
    match /coupon_sessions/{sessionId} {
      allow read: if true;  // Allow session lookup
      allow write: if false; // Only backend can write
    }

    // User credentials (Dhan, trading accounts): user-isolated read/write
    match /user_credentials/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Dhan credentials: write-only for users, read for cloud functions
    match /dhan_credentials/{userId} {
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow read: if false; // No client read access (System Only)
    }

    // Demat, portfolio, and funds — user-restricted
    match /demat_accounts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Trading sessions and logs — user-restricted
    match /trading_sessions/{sessionId} {
      // Allow users to read/create their own sessions
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      
      match /logs/{logId} {
        allow read: if request.auth != null;
        allow write: if false; // Backend only
      }
      // Trading session state (e.g., circuit breaker) - client read-only
      match /state/{docId} {
        allow read: if request.auth != null;
        allow write: if false; // Backend only
      }
    }

    // AI Signals - Read-only for users (own signals only), backend write-only
    match /ai_signals/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;  // Backend/Cloud Functions only
    }

    // Trades - User-isolated read/write
    match /trades/{docId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.createdBy
      );
      allow write: if false;  // Backend/Cloud Functions only
    }

    // User sessions - client read-only for own session, backend writes
    match /user_sessions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Backend only
    }

    // Trade audit timeline - client read own events only
    match /trade_audit/{docId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        request.auth.uid == resource.data.userId
      );
      allow write: if false; // Backend only
    }
  }
}
