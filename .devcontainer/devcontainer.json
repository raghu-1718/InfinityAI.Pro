{
  "name": "InfinityAI.Pro Dev Container",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install --upgrade pip && (test -f backend/requirements.txt && pip install -r backend/requirements.txt || true) && (test -f frontend/web-app/package.json && cd frontend/web-app && npm install || true)",
  "forwardPorts": [8080, 3000, 5000, 8085],
  "remoteUser": "vscode",

  "mounts": [],

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers/features/google-cloud-cli:1": {},
    "ghcr.io/devcontainers/features/firebase-cli:1": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.autoImportCompletions": true,
        "cloudcode.project": "gen-lang-client-0779271931",
        "cloudcode.region": "us-central1",
        "cloudcode.framework": "python",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "github.copilot.enable": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.env.linux": {
          "GCP_PROJECT": "gen-lang-client-0779271931",
          "FIREBASE_PROJECT": "gen-lang-client-0779271931"
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.datawrangler",
        "ms-toolsai.jupyter",
        "googlecloudtools.cloudcode",
        "googlecloudtools.firebase-dataconnect-vscode",
        "google.geminicodeassist",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens",
        "github.copilot",
        "github.copilot-chat",
        "hashicorp.terraform",
        "redhat.vscode-yaml"
      ]
    }
  },

  "containerEnv": {
    "GCP_PROJECT": "gen-lang-client-0779271931",
    "PYTHONPATH": "/workspace",
    "FIREBASE_PROJECT": "gen-lang-client-0779271931"
  },

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace"
}
