{
  "name": "InfinityAI.Pro Dev Container",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "postCreateCommand": "pip install -r backend/requirements.txt && npm install --prefix frontend-new && gcloud auth application-default login --quiet || true",
  "forwardPorts": [8080, 3000, 5000, 8085],
  "remoteUser": "vscode",

  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "source=${localWorkspaceFolder}/.secrets,target=/workspace/.secrets,type=bind"
  ],

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers/features/google-cloud-cli:1": {},
    "ghcr.io/devcontainers/features/firebase-cli:1": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.autoImportCompletions": true,
        "cloudcode.project": "infinity-ai-5ec7c",
        "cloudcode.region": "us-central1",
        "cloudcode.framework": "python",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "github.copilot.enable": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.env.linux": {
          "GOOGLE_APPLICATION_CREDENTIALS": "/workspace/.secrets/service-account.json",
          "GCP_PROJECT": "infinity-ai-5ec7c",
          "FIREBASE_PROJECT": "infinity-ai-5ec7c",
          "GEMINI_API_KEY": "${env:GEMINI_API_KEY}",
          "OPENAI_API_KEY": "${env:OPENAI_API_KEY}",
          "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}"
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.datawrangler",
        "ms-toolsai.jupyter",
        "googlecloudtools.cloudcode",
        "googlecloudtools.firebase-dataconnect-vscode",
        "google.geminicodeassist",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens",
        "github.copilot",
        "github.copilot-chat",
        "hashicorp.terraform",
        "redhat.vscode-yaml"
      ]
    }
  },

  "runArgs": [
    "--env-file",
    "/workspace/.env"
  ],

  "containerEnv": {
    "GCP_PROJECT": "infinity-ai-5ec7c",
    "GOOGLE_APPLICATION_CREDENTIALS": "/workspace/.secrets/service-account.json",
    "PYTHONPATH": "/workspace",
    "FIREBASE_PROJECT": "infinity-ai-5ec7c"
  },

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace"
}
