# ================================================================
# InfinityAI.Pro - PRODUCTION Environment Configuration Template
# ================================================================
# Project: I Am Infinity (galvanic-pulsar-482815-h0)
# Last Updated: 2026-01-06
#
# CRITICAL INSTRUCTIONS:
# 1. DO NOT commit actual secrets, tokens, or API keys to git
# 2. Use GCP Secret Manager for all sensitive values
# 3. Load into Cloud Run via deployment manifest or CLI
# 4. Verify all URLs match deployed Cloud Run services
# ================================================================

# ================================================================
# GCP & Cloud Foundation (REQUIRED)
# ================================================================
GOOGLE_CLOUD_PROJECT=galvanic-pulsar-482815-h0
GCP_REGION=us-central1
FIREBASE_PROJECT_ID=galvanic-pulsar-482815-h0

# ================================================================
# Service URLs (REQUIRED - MUST match deployed Cloud Run services)
# ================================================================
# Discover current URLs via:
# gcloud run services list --region=us-central1 --project=galvanic-pulsar-482815-h0
ENGINE_A_URL=https://engine-a-3acobgd3qa-uc.a.run.app
ENGINE_B_URL=https://engine-b-3acobgd3qa-uc.a.run.app
ENGINE_C_URL=https://engine-c-3acobgd3qa-uc.a.run.app

# ================================================================
# Observability & Cloud Tracing (REQUIRED)
# ================================================================
# Production: Use Cloud Trace API endpoint
# Local Dev: Use localhost:4317 with OpenTelemetry Collector
OTEL_EXPORTER_OTLP_ENDPOINT=cloudtrace.googleapis.com:443
OTEL_TRACE_SAMPLE_RATE=0.1

# ================================================================
# Broker Integration (REQUIRED - Load from Secret Manager)
# ================================================================
# Secret Manager commands:
# gcloud secrets versions access latest --secret=dhan-client-id --project=galvanic-pulsar-482815-h0
# gcloud secrets versions access latest --secret=dhan-api-secret --project=galvanic-pulsar-482815-h0
# gcloud secrets versions access latest --secret=dhan-access-token --project=galvanic-pulsar-482815-h0
DHAN_CLIENT_ID=from-secret-manager
DHAN_API_SECRET=from-secret-manager
DHAN_ACCESS_TOKEN=from-secret-manager

# ================================================================
# AI & LLM (OPTIONAL - Load from Secret Manager if using Gemini)
# ================================================================
# gcloud secrets versions access latest --secret=openai-api-key --project=galvanic-pulsar-482815-h0
GEMINI_API_KEY=from-secret-manager

# ================================================================
# Security & Encryption (OPTIONAL - Load from Secret Manager)
# ================================================================
# gcloud secrets versions access latest --secret=encryption-key --project=galvanic-pulsar-482815-h0
ENCRYPTION_KEY=from-secret-manager

# ================================================================
# Cloud Storage (OPTIONAL)
# ================================================================
GCS_MODELS_BUCKET=infinityai-models-galvanic
GCS_HISTORY_BUCKET=infinityai-history-galvanic

# ================================================================
# Trading & Risk Configuration
# ================================================================
TRADING_MODE=paper
ALLOWED_EXECUTION_SOURCE=engine-a
SESSION_TIMEOUT_MINUTES=60
ENABLE_AUTO_TRADING=false
MIN_CONFIDENCE_THRESHOLD=0.75
MAX_RISK_PER_TRADE=0.02
ENABLE_EVALUATION=true

# ================================================================
# Logging & Debug
# ================================================================
LOG_LEVEL=INFO
ENABLE_STRUCTURED_LOGGING=true
DEBUG=false
ALLOW_LOCALHOST_CORS=false

# ================================================================
# Database
# ================================================================
FIRESTORE_DATABASE=default

# ================================================================
# PRODUCTION DEPLOYMENT VERIFICATION CHECKLIST
# ================================================================
# Before deploying:
# [ ] All REQUIRED variables populated
# [ ] All SECRET values from Secret Manager
# [ ] URLs verified: gcloud run services list --region=us-central1 --project=galvanic-pulsar-482815-h0
# [ ] Health check: curl https://engine-a-3acobgd3qa-uc.a.run.app/health
# [ ] Cloud Trace active: gcloud trace list --project=galvanic-pulsar-482815-h0
# [ ] Firestore rules deployed: firebase deploy --only firestore:rules --project=galvanic-pulsar-482815-h0
WIF_SERVICE_ACCOUNT=workload-identity-provider                  # Workload Identity Federation (if used)

# =====================
# FRONTEND (NEXT.JS, ETC.)
# =====================
NEXT_PUBLIC_API_URL=https://api.example.com                     # Public API endpoint for frontend
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key              # Firebase config for frontend
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# =====================
# LEGACY / OPTIONAL (REMOVE IF UNUSED)
# =====================
# API_SECRET_KEY=legacy-api-secret-key
# JWT_SECRET=legacy-jwt-secret
# DATABASE_URL=sqlite:///local.db

# --------------------------------------------------
# For any new secret or config, add a placeholder and documentation here.
# All services must fail fast if required variables are missing.
# --------------------------------------------------GOOGLE_CLOUD_PROJECT=
NODE_ENV=
LOG_LEVEL=
