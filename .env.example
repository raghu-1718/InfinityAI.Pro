# InfinityAI.Pro Environment Variables Example
# --------------------------------------------------
# Copy this file to `.env` and fill in the real values for your environment.
# DO NOT commit secrets or credentials to version control.

# =====================
# GLOBAL / COMMON
# =====================
GOOGLE_CLOUD_PROJECT=your-gcp-project-id   # GCP Project ID

# =====================
# BACKEND ENGINES (A, B, C)
# =====================
ENGINE_A_URL=https://engine-a.example.com  # URL for Engine A (if needed by other services)
ENGINE_B_URL=https://engine-b.example.com  # URL for Engine B
ENGINE_C_URL=https://engine-c.example.com  # URL for Engine C

# =====================
# GOOGLE CLOUD STORAGE
# =====================
GCS_MODELS_BUCKET=infinityai-models        # GCS bucket for ML models
GCS_HISTORY_BUCKET=infinityai-history      # GCS bucket for trading history

# =====================
# DHAN BROKER INTEGRATION
# (All values are injected via GCP Secret Manager in production)
# =====================
DHAN_CLIENT_ID=your-dhan-client-id         # Dhan API Client ID
DHAN_API_SECRET=your-dhan-api-secret       # Dhan API Secret
DHAN_ACCESS_TOKEN=your-dhan-access-token   # Dhan API Access Token

# =====================
# GEMINI API (ENGINE-B)
# =====================
GEMINI_API_KEY=your-gemini-api-key         # Gemini API Key (required by engine-b)

# =====================
# ENCRYPTION KEY (ENGINE-C)
# =====================
ENCRYPTION_KEY=your-encryption-key         # Encryption key for engine-c

# =====================
# FIREBASE DEPLOYMENT
# =====================
FIREBASE_SERVICE_ACCOUNT=path/to/firebase-service-account.json  # Path or JSON for Firebase deploy

# =====================
# GCP DEPLOYMENT (CI/CD)
# =====================
GCP_SERVICE_ACCOUNT=path/to/gcp-service-account.json            # Path or JSON for GCP deploy
WIF_SERVICE_ACCOUNT=workload-identity-provider                  # Workload Identity Federation (if used)

# =====================
# FRONTEND (NEXT.JS, ETC.)
# =====================
NEXT_PUBLIC_API_URL=https://api.example.com                     # Public API endpoint for frontend
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key              # Firebase config for frontend
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# =====================
# LEGACY / OPTIONAL (REMOVE IF UNUSED)
# =====================
# API_SECRET_KEY=legacy-api-secret-key
# JWT_SECRET=legacy-jwt-secret
# DATABASE_URL=sqlite:///local.db

# --------------------------------------------------
# For any new secret or config, add a placeholder and documentation here.
# All services must fail fast if required variables are missing.
# --------------------------------------------------GOOGLE_CLOUD_PROJECT=
NODE_ENV=
LOG_LEVEL=
