# ================================================================
# InfinityAI.Pro - Environment Configuration Template
# ================================================================
# Architecture: Railway (Backend) · Vercel (Frontend) · Supabase (DB/Auth)
# Last Updated: 2026-04-18
#
# CRITICAL INSTRUCTIONS:
# 1. DO NOT commit actual secrets, tokens, or API keys to git
# 2. Set these as Railway service variables or Vercel env vars
# 3. Verify all URLs match deployed services
# ================================================================

# ================================================================
# Supabase (REQUIRED)
# ================================================================
SUPABASE_URL=https://swhibyoewpvgnubzbztq.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ================================================================
# Encryption (REQUIRED)
# ================================================================
# AES-256 key for encrypting broker credentials in Supabase
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# ================================================================
# Service URLs (REQUIRED - set after Railway deployment)
# ================================================================
ENGINE_A_URL=https://engine-a.up.railway.app
ENGINE_B_URL=https://engine-b.up.railway.app
ENGINE_C_URL=https://engine-c.up.railway.app

# ================================================================
# Frontend Environment Variables (Vercel)
# ================================================================
NEXT_PUBLIC_SUPABASE_URL=https://swhibyoewpvgnubzbztq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_ENGINE_C_URL=https://engine-c.up.railway.app

# ================================================================
# Broker Integration (REQUIRED for live trading)
# ================================================================
DHAN_CLIENT_ID=your-dhan-client-id
DHAN_API_SECRET=your-dhan-api-secret
DHAN_ACCESS_TOKEN=your-dhan-access-token

# ================================================================
# AI & LLM (OPTIONAL)
# ================================================================
GEMINI_API_KEY=your-gemini-api-key

# ================================================================
# Trading & Risk Configuration
# ================================================================
TRADING_MODE=paper
ALLOWED_EXECUTION_SOURCE=engine-a
SESSION_TIMEOUT_MINUTES=60
ENABLE_AUTO_TRADING=false
MIN_CONFIDENCE_THRESHOLD=0.75
MAX_RISK_PER_TRADE=0.02
ENABLE_EVALUATION=true

# ================================================================
# Logging & Debug
# ================================================================
LOG_LEVEL=INFO
DEBUG=false
NODE_ENV=production

# ================================================================
# Legacy (Deprecated - kept for backward compatibility)
# ================================================================
GOOGLE_CLOUD_PROJECT=dev-project
# FIRESTORE_DATABASE=default  # No longer used — Supabase PostgreSQL
