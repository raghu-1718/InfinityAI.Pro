# ================================================================
# InfinityAI.Pro - Environment Configuration Template
# ================================================================
# Architecture: Google Cloud Platform (Cloud Run, Firebase Firestore, BigQuery, Vertex AI)
# Last Updated: 2026-08-16
#
# CRITICAL INSTRUCTIONS:
# 1. DO NOT commit actual secrets, tokens, or API keys to git
# 2. Set these as Cloud Run environment variables or Secrets Manager secrets
# 3. Verify all GCP project IDs and regions match your deployed services
# ================================================================

# ================================================================
# Google Cloud Platform & Firebase (REQUIRED)
# ================================================================
GOOGLE_CLOUD_PROJECT=project-841b7f97-5ee3-4fbe-920
GOOGLE_CLOUD_REGION=asia-south1
FIREBASE_DATABASE_ID=(default)
USER_ID=znyNtT2lW3MKHqFrVA6E0A2Iv3N2

# ================================================================
# Encryption (REQUIRED)
# ================================================================
# AES-256 key for encrypting broker credentials in Firestore
ENCRYPTION_KEY=your-32-byte-encryption-key-here
USER_CREDENTIALS_KEY=your-user-credentials-decryption-key

# ================================================================
# Service URLs (REQUIRED - GCP Cloud Run / Internal Endpoints)
# ================================================================
ENGINE_A_URL=https://engine-a-dot-project-841b7f97-5ee3-4fbe-920.asia-south1.run.app
ENGINE_B_URL=https://engine-b-dot-project-841b7f97-5ee3-4fbe-920.asia-south1.run.app
ENGINE_C_URL=https://engine-c-dot-project-841b7f97-5ee3-4fbe-920.asia-south1.run.app

# ================================================================
# Frontend Environment Variables (Vercel / Next.js)
# ================================================================
NEXT_PUBLIC_GCP_PROJECT_ID=project-841b7f97-5ee3-4fbe-920
NEXT_PUBLIC_ENGINE_A_URL=https://engine-a-dot-project-841b7f97-5ee3-4fbe-920.asia-south1.run.app
NEXT_PUBLIC_ENGINE_C_URL=https://engine-c-dot-project-841b7f97-5ee3-4fbe-920.asia-south1.run.app

# ================================================================
# Broker Integration (REQUIRED for live trading / DhanHQ)
# ================================================================
DHAN_CLIENT_ID=your-dhan-client-id
DHAN_API_SECRET=your-dhan-api-secret
DHAN_ACCESS_TOKEN=your-dhan-access-token

# ================================================================
# AI & LLM (Vertex AI / Gemini)
# ================================================================
GEMINI_API_KEY=your-gemini-api-key
VERTEX_AI_LOCATION=us-central1

# ================================================================
# Trading & Risk Configuration
# ================================================================
TRADING_MODE=paper
ALLOWED_EXECUTION_SOURCE=engine-a
SESSION_TIMEOUT_MINUTES=60
ENABLE_AUTO_TRADING=false
MIN_CONFIDENCE_THRESHOLD=0.75
MAX_RISK_PER_TRADE=0.02
ENABLE_EVALUATION=true

# ================================================================
# Logging & Debug
# ================================================================
LOG_LEVEL=INFO
DEBUG=false
NODE_ENV=production
