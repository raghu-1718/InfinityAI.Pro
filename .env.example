# InfinityAI.Pro Environment Configuration

# Dhan API Configuration (Replace with your actual credentials)
DHAN_ACCESS_TOKEN=your_dhan_access_token_here
DHAN_CLIENT_ID=your_dhan_client_id_here

# Engine URLs (Canonical Cloud Run service URLs)
# New standardized services: infinityai-engine-a/b/c-execution/d
ENGINE_A_URL=https://infinityai-engine-a-573866363639.us-central1.run.app
ENGINE_B_URL=https://infinityai-engine-b-573866363639.us-central1.run.app
ENGINE_C_URL=https://infinityai-engine-c-execution-573866363639.us-central1.run.app
ENGINE_D_URL=https://infinityai-engine-d-573866363639.us-central1.run.app
ULTRA_AGGRESSIVE_URL=https://engine-ultra-aggressive-prod-573866363639.us-central1.run.app

# GCP Configuration
GCP_PROJECT_ID=infinityai-pro
GCP_REGION=us-central1

# Security
API_SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here

# Database (if using)
DATABASE_URL=sqlite:///./infinityai.db

# Logging
LOG_LEVEL=INFO